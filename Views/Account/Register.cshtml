@model RegisterModel
@{ ViewData["Title"] = "Create account"; }
<section class="auth-card"><a class="brand" href="/">▧ FileSpace<span class="brand-dot">.</span></a><p class="eyebrow">A SPACE FOR YOUR EVERYDAY FILES</p><h1>Make yourself at home.</h1><p class="muted">Create your account and keep everything in one place.</p><form method="post" asp-action="Register"><div asp-validation-summary="All" class="validation" role="alert"></div><label asp-for="DisplayName">Your name</label><input asp-for="DisplayName" autocomplete="name" /><label asp-for="Username"></label><input asp-for="Username" autocomplete="username" /><label asp-for="Email"></label><input asp-for="Email" autocomplete="email" /><label asp-for="Password"></label><input asp-for="Password" autocomplete="new-password" /><small>At least 8 characters, with uppercase, lowercase, a number and a symbol.</small><label asp-for="ConfirmPassword">Confirm password</label><input asp-for="ConfirmPassword" autocomplete="new-password" /><button class="button full" type="submit">Create account →</button></form><p class="auth-footer">Already have an account? <a asp-action="Login">Sign in</a></p></section>
