@model LoginModel
@{ ViewData["Title"] = "Sign in"; }
<section class="auth-card"><a class="brand" href="/">▧ FileSpace<span class="brand-dot">.</span></a><p class="eyebrow">YOUR FILES. YOUR SPACE.</p><h1>Welcome back.</h1><p class="muted">Sign in to pick up where you left off.</p><form asp-action="Login" method="post"><div asp-validation-summary="All" class="validation" role="alert"></div><input asp-for="ReturnUrl" type="hidden" /><label asp-for="Username"></label><input asp-for="Username" autocomplete="username" /><label asp-for="Password"></label><input asp-for="Password" autocomplete="current-password" /><label class="checkbox"><input asp-for="RememberMe" /> Keep me signed in</label><button class="button full" type="submit">Sign in →</button></form><p class="auth-footer">New here? <a asp-action="Register">Create an account</a></p></section>
