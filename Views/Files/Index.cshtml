@model FilesModel
@{ ViewData["Title"] = "My files"; }
<header class="page-header"><div><p class="eyebrow">EVERYTHING IN ITS PLACE</p><h1>My files<span class="brand-dot">.</span></h1><p class="muted">Find, download, and make room for something new.</p></div><a class="button" asp-action="Upload">＋ Upload a file</a></header><section class="panel"><form method="get" asp-action="Index" class="search-bar"><label class="sr-only" for="search">Search files</label><input id="search" name="search" value="@Model.Search" placeholder="Search by file name…" /><label class="sr-only" for="type">File type</label><select id="type" name="type"><option value="">All file types</option>@foreach (string ext in ViewBag.Extensions) { <option value="@ext" selected="@(Model.Type == ext)">@ext.TrimStart('.').ToUpperInvariant()</option> }</select><button class="button" type="submit">Search</button><a asp-action="Index" class="text-link">Clear</a></form><div class="section-header"><h2>@Model.Files.Count @(Model.Files.Count == 1 ? "file" : "files")</h2><span class="muted">Newest first</span></div>@await Html.PartialAsync("_FileTable", Model.Files)</section>
