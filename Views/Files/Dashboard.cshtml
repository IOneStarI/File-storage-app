@model FilesModel
@{ ViewData["Title"] = "Dashboard"; }
<header class="page-header"><div><p class="eyebrow">YOUR PERSONAL WORKSPACE</p><h1>Hello, @ViewBag.DisplayName<span class="brand-dot">.</span></h1><p class="muted">A little more organized. A lot more peace of mind.</p></div><a class="button" asp-action="Upload">＋ Upload a file</a></header>
<section class="welcome-panel"><div><span class="badge">ALL YOUR FILES, TOGETHER</span><h2>Room for what matters.</h2><p>From big ideas to everyday essentials,<br />give your files a place to call home.</p><a asp-action="Upload" class="button light">@(Model.TotalCount == 0 ? "Upload your first file" : "Upload another file") ↗</a></div><div class="folder-art" aria-hidden="true"><div class="paper">▤<br /><span>your next big idea</span></div><div class="folder">✦</div><span class="art-dot one"></span><span class="art-dot two"></span></div></section>
<section class="stats"><div class="stat"><span class="stat-icon">▤</span><div><p>Total files</p><strong>@Model.TotalCount</strong><small>All in your personal space</small></div></div><div class="stat"><span class="stat-icon peach">◷</span><div><p>Storage used</p><strong>@FileDisplay.Size(Model.TotalSize)</strong><small>Stored locally on this computer</small></div></div></section>
<section class="panel"><div class="section-header"><div><h2>Recently uploaded</h2><p class="muted">Your latest additions, right here.</p></div><a asp-action="Index" class="text-link">View all files →</a></div>@await Html.PartialAsync("_FileTable", Model.Files)</section>
