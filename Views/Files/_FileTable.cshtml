@model List<StoredFile>
@if (Model.Count == 0) { <div class="empty-state"><div class="empty-icon">▧</div><h3>A little space for something new.</h3><p class="muted">No files to show. Upload a file or adjust your search.</p><a asp-action="Upload" class="button">Upload a file →</a></div> }
else { <div class="table-scroll"><table><thead><tr><th>FILE NAME</th><th>SIZE</th><th>UPLOADED (UTC)</th><th class="actions">ACTIONS</th></tr></thead><tbody>@foreach (var file in Model) { <tr><td><div class="file-name"><span class="file-icon">@file.Extension.TrimStart('.').ToUpperInvariant()</span><div><strong>@file.OriginalName</strong><small>@file.Extension.TrimStart('.').ToUpperInvariant() file</small></div></div></td><td>@FileDisplay.Size(file.Size)</td><td>@file.UploadedAt.ToString("MMM dd, yyyy")<small>@file.UploadedAt.ToString("HH:mm") UTC</small></td><td><div class="file-actions"><a asp-action="Download" asp-route-id="@file.Id" class="icon-button" aria-label="Download @file.OriginalName" title="Download">↓</a><form method="post" asp-action="Delete" asp-route-id="@file.Id" data-confirm="Delete this file permanently?"><button type="submit" class="icon-button delete" aria-label="Delete @file.OriginalName" title="Delete">×</button></form></div></td></tr> }</tbody></table></div> }
