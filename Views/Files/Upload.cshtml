@{ ViewData["Title"] = "Upload files"; StorageOptions options = ViewBag.Options; }
<header class="page-header"><div><p class="eyebrow">MAKE YOURSELF SOME SPACE</p><h1>Upload files<span class="brand-dot">.</span></h1><p class="muted">A new home for your documents, photos, and ideas.</p></div></header><section class="panel upload-panel"><form asp-action="Upload" method="post" enctype="multipart/form-data" id="upload-form"><div asp-validation-summary="All" class="validation" role="alert"></div><div class="drop-zone" id="drop-zone"><div class="upload-icon">↑</div><h2>Drop your files right here</h2><p class="muted">or choose several from your computer</p><label class="button file-picker" for="file">Browse files</label><input type="file" id="file" name="files" multiple accept="@string.Join(",", options.AllowedExtensions)" required data-max-size="@options.MaxFileBytes" data-max-count="@StorageOptions.MaxFilesPerUpload" data-max-total="@StorageOptions.MaxBatchBytes" /><p class="muted">Up to @FileDisplay.Size(options.MaxFileBytes) per file · Up to @StorageOptions.MaxFilesPerUpload files and @FileDisplay.Size(StorageOptions.MaxBatchBytes) total</p></div><div id="file-preview" class="file-preview" aria-live="polite">No files selected</div><p id="upload-error" class="validation" role="alert"></p><div class="upload-footer"><span class="muted">♧ Visible only to you</span><button class="button" type="submit" id="upload-button">Upload files ↑</button></div></form></section><section class="upload-info"><h3>A few things to know</h3><p>Supported formats: @string.Join(", ", options.AllowedExtensions.Select(e => e.TrimStart('.').ToUpperInvariant())).</p><p>Files are stored on this computer. You can download or delete them at any time from My files.</p></section>
